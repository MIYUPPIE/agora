# Copy to .env, fill in real values, and never commit the filled-in copy.
# `docker-compose.yml` reads this automatically.

# ---- Core (required) ----
SECRET_KEY_BASE=   # generate with: mix phx.gen.secret
DATABASE_URL=ecto://agora:agora@db/agora_prod
PHX_HOST=your-domain.example
PHX_SERVER=true

# ---- Optional core tuning ----
PORT=4000
POOL_SIZE=10
# ECTO_IPV6=true
# DNS_CLUSTER_QUERY=

# ---- Live Gatherings (RTMP -> HLS) ----
RTMP_PORT=1935
# Local disk root for live segments + (R2-less) recordings; nginx reads the
# same path directly — see deploy/nginx.conf.example. Matches the
# `media_root` Docker volume declared in the Dockerfile/docker-compose.yml.
MEDIA_ROOT=/app/media_root

# ---- Object storage (R2/S3) — post uploads, recordings, replay archives ----
# Leave all of these unset to fall back to local disk under MEDIA_ROOT /
# priv/static/uploads (fine for a single box without a CDN in front yet).
# R2_UPLOADS_BUCKET=agora-media
# R2_RECORDINGS_BUCKET=agora-media   # defaults to R2_UPLOADS_BUCKET if unset
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# CDN_BASE_URL=https://cdn.your-domain.example

# ---- Postgres (docker-compose's db service only) ----
POSTGRES_USER=agora
POSTGRES_PASSWORD=agora
POSTGRES_DB=agora_prod
