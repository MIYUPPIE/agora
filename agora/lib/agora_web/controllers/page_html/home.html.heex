<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto w-full max-w-md text-center py-8">
    <div class="rounded-full p-1 depth-glow inline-block rise-in">
      <img src={~p"/images/agora-mark.png"} width="96" alt="Agora" class="rounded-full" />
    </div>

    <h1
      class="mt-5 text-4xl font-bold tracking-wide text-base-content rise-in"
      style="animation-delay: 60ms"
    >
      AGORA
    </h1>
    <p class="mt-2 text-lg text-primary font-medium rise-in" style="animation-delay: 100ms">
      The gathering place
    </p>
    <p class="mt-4 text-base text-base-content/70 rise-in" style="animation-delay: 140ms">
      Go live with your voice, share a Tiding, and Cling to the people
      whose voices matter to you — an audio-first home for your community.
    </p>

    <div class="mt-8 flex flex-col gap-3 rise-in" style="animation-delay: 180ms">
      <.link
        navigate={~p"/users/register"}
        class="btn btn-primary btn-lg w-full active:scale-95 transition-transform"
      >
        Sign Up
      </.link>
      <.link
        navigate={~p"/users/log-in"}
        class="btn btn-lg btn-outline w-full active:scale-95 transition-transform"
      >
        Log In
      </.link>
    </div>

    <div class="mt-12 space-y-3 text-left">
      <div
        class="rounded-box glass depth-card p-4 flex items-start gap-3 rise-in"
        style="animation-delay: 220ms"
      >
        <div class="flex items-center justify-center size-11 rounded-full bg-primary text-white shrink-0 depth-glow">
          <.icon name="hero-microphone" class="size-5" />
        </div>
        <div>
          <p class="font-semibold text-base-content">Gatherings</p>
          <p class="text-sm text-base-content/60">
            Go live with real-time audio — straight from your phone's browser, no extra app required.
          </p>
        </div>
      </div>

      <div
        class="rounded-box glass depth-card p-4 flex items-start gap-3 rise-in"
        style="animation-delay: 260ms"
      >
        <div class="flex items-center justify-center size-11 rounded-full bg-primary text-white shrink-0 depth-glow">
          <.icon name="hero-megaphone" class="size-5" />
        </div>
        <div>
          <p class="font-semibold text-base-content">Tidings</p>
          <p class="text-sm text-base-content/60">
            Share a thought, a photo, or a voice note — quick posts for the people who cling to you.
          </p>
        </div>
      </div>

      <div
        class="rounded-box glass depth-card p-4 flex items-start gap-3 rise-in"
        style="animation-delay: 300ms"
      >
        <div class="flex items-center justify-center size-11 rounded-full bg-primary text-white shrink-0 depth-glow">
          <.icon name="hero-user-group" class="size-5" />
        </div>
        <div>
          <p class="font-semibold text-base-content">Clings</p>
          <p class="text-sm text-base-content/60">
            Follow the people whose voices matter to you, and never miss when they go live.
          </p>
        </div>
      </div>
    </div>

    <p class="mt-10 text-xs text-base-content/40 rise-in" style="animation-delay: 340ms">
      &copy; {Date.utc_today().year} Agora
    </p>
  </div>
</Layouts.app>
